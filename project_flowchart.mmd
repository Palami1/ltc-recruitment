graph TD
    %% Applicant Flow
    Start([ຜູ້ສະໝັກເຂົ້າສູ່ເວັບໄຊ]) --> Landing[ໜ້າຫຼັກ Landing Page\nກົດປຸ່ມ 'ຟອມສະໝັກວຽກ']
    Landing --> Selection[ໜ້າເລືອກຕຳແໜ່ງ Selection Page\nລະບົບສະແດງຕຳແໜ່ງເປີດຮັບ]
    Selection --> ViewJob[ໜ້າລາຍລະອຽດຕຳແໜ່ງ Job Details\nກວດເບິ່ງເງື່ອນໄຂ ແລະ ເອກະສານ]
    ViewJob --> ApplyForm[ປະກອບຟອມສະໝັກ\n- ຂໍ້ມູນສ່ວນຕົວ\n- ປະຫວັດການສຶກສາ/ວຽກ\n- ອັບໂຫຼດຮູບ 3x4]
    ApplyForm --> Submit[ກົດສົ່ງໃບສະໝັກ]
    
    %% Backend Flow
    Submit --> SystemProcess{ລະບົບ Backend ປະມວນຜົນ}
    SystemProcess -- "ບັນທຶກຂໍ້ມູນ" --> DB[(ຖານຂໍ້ມູນ Database)]
    SystemProcess -- "ສ້າງໄຟລ໌ PDF ອັດຕະໂນມັດ" --> PDF[ສ້າງໃບສະໝັກ PDF]
    
    PDF --> Success([ຜູ້ສະໝັກ: ແຈ້ງເຕືອນສະໝັກສຳເລັດ!])
    
    %% Admin Flow
    AdminStart([ພະນັກງານ HR ເຂົ້າສູ່ລະບົບ]) --> AdminLogin[Admin Login]
    AdminLogin --> AdminDash[ໜ້າ Admin Dashboard]
    DB -. "ດຶງລາຍຊື່ຜູ້ສະໝັກ" .-> AdminDash
    PDF -. "ດາວໂຫຼດໃບສະໝັກ" .-> AdminDash
    
    AdminDash --> Review[Admin ກວດສອບເອກະສານ\nແລະ ຄຸນສົມບັດ]
    
    Review --> AdminDecision{Admin ຕັດສິນໃຈ\nຜ່ານການຄັດເລືອກບໍ່?}
    
    AdminDecision -- "ຜ່ານ" --> Contact[ຕິດຕໍ່ຜູ້ສະໝັກ\nເພື່ອນັດສຳພາດ]
    AdminDecision -- "ບໍ່ຜ່ານ" --> Reject[ເກັບໄວ້ເປັນປະຫວັດ\n(ບໍ່ໄດ້ຮັບການຕິດຕໍ່)]
    
    Contact --> End([ສິ້ນສຸດ: ເຂົ້າສູ່ຂະບວນການສຳພາດ])
    Reject --> EndReject([ສິ້ນສຸດ])

    %% Styling
    classDef applicant fill:#bbdefb,stroke:#1976d2,stroke-width:2px;
    classDef system fill:#ffe0b2,stroke:#f57c00,stroke-width:2px;
    classDef admin fill:#c8e6c9,stroke:#388e3c,stroke-width:2px;
    classDef database fill:#e1bee7,stroke:#8e24aa,stroke-width:2px;
    classDef startend fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px;
    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;
    
    class Start,Success,AdminStart,End,EndReject startend;
    class Landing,Selection,ViewJob,ApplyForm,Submit applicant;
    class SystemProcess,PDF system;
    class DB database;
    class AdminLogin,AdminDash,Review,Contact,Reject admin;
    class AdminDecision decision;
