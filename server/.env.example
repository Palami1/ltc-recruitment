# ================================================================
# LTC RECRUITMENT PORTAL — SERVER ENVIRONMENT CONFIGURATION
# ================================================================

# Port for backend Express server (Default: 5000)
PORT=5000

# Central MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster0.mongodb.net/ltc_recruitment?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/ltc_recruitment?retryWrites=true&w=majority

# Admin Dashboard Password (Used for Admin Login)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123

# Cryptographically Secure JWT Secret Key (Minimum 32 characters)
# Used for signing stateless admin JWT session tokens
ADMIN_JWT_SECRET=generate_a_random_32_to_64_character_hex_secret_here

# SMTP Email Dispatch Configuration (Brevo / Gmail)
# Used by Nodemailer to send status updates & interview invitations
SMTP_USER=your_brevo_or_gmail_email@domain.com
SMTP_PASS=your_smtp_app_password_or_api_key
