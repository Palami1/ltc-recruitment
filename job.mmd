graph TD
    Start([ເລີ່ມຕົ້ນ]) --> Search[ຄົ້ນຫາວຽກ]
    Search --> Prepare[ກຽມເອກະສານສະໝັກວຽກ \n Resume, Cover Letter, ໃບປະກາດ...]
    Prepare --> Submit[ສົ່ງໃບສະໝັກ]
    Submit --> Wait[ລໍຖ້າການຕິດຕໍ່ກັບ / ຕິດຕາມຜົນ]
    
    Wait --> Decision1{ໄດ້ຮັບການຕິດຕໍ່\nສຳພາດບໍ່?}
    
    Decision1 -- "ໄດ້ຮັບ" --> Interview[ເຂົ້າຮ່ວມການສຳພາດ]
    Decision1 -- "ບໍ່ໄດ້ຮັບ/ງຽບຫາຍ" --> FollowUp[ຕິດຕໍ່ສອບຖາມຜົນ \n ຜ່ານທາງອີເມວ ຫຼື ໂທລະສັບ]
    
    FollowUp --> Decision2{ຖືກປະຕິເສດ ຫຼື\nບໍ່ມີການຕອບກັບ?}
    Decision2 -- "ແມ່ນ" --> Review[ທົບທວນຄືນຂໍ້ບົກຜ່ອງ\nແລະ ປັບປຸງເອກະສານໃໝ່]
    Review --> Search
    Decision2 -- "ບໍລິສັດຂໍເວລາພິຈາລະນາເພີ່ມ" --> Wait
    
    Interview --> Decision3{ຜ່ານການສຳພາດບໍ່?}
    Decision3 -- "ຜ່ານ" --> Offer[ໄດ້ຮັບການສະເໜີວຽກ\nແລະ ເຊັນສັນຍາ]
    Decision3 -- "ບໍ່ຜ່ານ" --> Review
    
    Offer --> End([ສິ້ນສຸດ: ໄດ້ຮັບວຽກໃໝ່!])

    classDef startEnd fill:#f4a460,stroke:#d2691e,stroke-width:2px;
    classDef process fill:#f4a460,stroke:#d2691e,stroke-width:2px;
    classDef decision fill:#f4a460,stroke:#d2691e,stroke-width:2px;
    
    class Start,End startEnd;
    class Search,Prepare,Submit,Wait,Interview,FollowUp,Review,Offer process;
    class Decision1,Decision2,Decision3 decision;
